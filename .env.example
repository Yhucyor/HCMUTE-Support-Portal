# ==============================================================================
# QAUTE PORTAL — FILE MẪU BIẾN MÔI TRƯỜNG (.env.example)
# ==============================================================================
# HƯỚNG DẪN:
#   1. Sao chép file này thành ".env" (KHÔNG có .example): copy .env.example .env
#   2. Điền giá trị thật vào file .env
#   3. File .env đã được .gitignore → KHÔNG bao giờ bị commit lên Git
#   4. TUYỆT ĐỐI KHÔNG điền key thật vào file này (.env.example)
# ==============================================================================

# ── DATABASE ──────────────────────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/qaute_portal?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=

# ── GOOGLE GEMINI API (AI Chatbot & Embedding) ────────────────────────────────
# Lấy key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── GMAIL SMTP (Gửi Email thông báo) ─────────────────────────────────────────
# Lấy App Password tại: https://myaccount.google.com/apppasswords
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=

# ── CLOUDINARY (Upload ảnh/video lên Cloud) ───────────────────────────────────
# Lấy tại: https://cloudinary.com/console
# Chỉ cần khi app.storage.provider=cloudinary trong application.yml
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── WEBHOOK SECRET ────────────────────────────────────────────────────────────
NODEJS_WEBHOOK_SECRET=mySuperSecretWebhookKey2026

# ── UPLOAD DIR (Local Storage) ────────────────────────────────────────────────
UPLOAD_DIR=C:/upload
