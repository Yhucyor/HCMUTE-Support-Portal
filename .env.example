# ==============================================================================
# QAUTE PORTAL — FILE MẪU BIẾN MÔI TRƯỜNG (.env.example)
# ==============================================================================
# HƯỚNG DẪN:
#   1. Sao chép file này thành ".env" (KHÔNG có .example): copy .env.example .env
#   2. Mở comment (#) ở TRẠNG THÁI muốn dùng (Local hoặc Cloud) và điền key thật
#   3. File .env đã được .gitignore → KHÔNG bao giờ bị commit lên Git
#   4. TUYỆT ĐỐI KHÔNG điền key thật vào file này (.env.example)
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# 👉 TRẠNG THÁI 1: TOÀN BỘ LOCAL (DATABASE LOCAL + AI LOCAL)
# ──────────────────────────────────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/qaute_portal?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=
DB_POOL_MAX=20
DB_POOL_MIN=5
AI_CHATBOT_URL=http://127.0.0.1:8000/api/chat
AI_MICROSERVICE_AUTO_START=true

# ──────────────────────────────────────────────────────────────────────────────
# 👉 TRẠNG THÁI 2: TOÀN BỘ CLOUD & AWS (DB TIDB CLOUD + AI AWS EC2)
# ──────────────────────────────────────────────────────────────────────────────
# DB_URL=jdbc:mysql://gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/test?sslMode=VERIFY_IDENTITY&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
# DB_USERNAME=your_tidb_username
# DB_PASSWORD=your_tidb_password
# DB_PASS=your_tidb_password
# DB_POOL_MAX=10
# DB_POOL_MIN=2
# AI_CHATBOT_URL=http://32.236.227.5:8000/api/chat
# AI_MICROSERVICE_AUTO_START=false

# ==============================================================================
# CÁC CẤU HÌNH DỊCH VỤ DÙNG CHUNG
# ==============================================================================

# ── 1. GMAIL SMTP (Gửi Email thông báo) ─────────────────────────────────────────
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=

# ── 2. GOOGLE GEMINI & DIFY API (AI Chatbot & Embedding) ──────────────────────
GEMINI_API_KEY=
DIFY_API_KEY=

# ── 3. GOOGLE OAUTH2 (Đăng nhập Google) ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 4. CLOUDINARY (Upload ảnh/video lên Cloud) ───────────────────────────────────
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── 5. WEBHOOK SECRET & UPLOAD DIR ─────────────────────────────────────────────
NODEJS_WEBHOOK_SECRET=mySuperSecretWebhookKey2026
UPLOAD_DIR=D:/portal/upload
